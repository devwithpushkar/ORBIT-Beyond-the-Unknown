# Java compiler output
*.class
bin/
out/
target/
build/
.gradle/

# IDE configurations
.idea/
*.iml
.vscode/
*.ipr
*.iws

# OS files
.DS_Store
Thumbs.db
ehthumbs.db

# Saves (preserve directory structure while ignoring local save data)
saves/*
