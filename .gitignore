# Assets (preserve static audio and visual assets while ignoring temporary files)
assets/temp/
assets/cache/
!assets/audio/
!assets/audio/*
!assets/.gitkeep

# Logs and crash reports
*.log
hs_err_pid*

# Antigravity configuration
.agent/

# Distribution & Release artifacts
dist/
release/

